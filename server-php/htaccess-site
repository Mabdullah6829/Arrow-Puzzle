# Arrow Puzzle site - managed by deploy/deploy.sh (do not edit on the server)
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType audio/ogg .ogg
AddType application/json .json
AddType application/javascript .js

<IfModule mod_headers.c>
  # Keep this modified game out of search engines
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  # Always fetch fresh code and data so deploys and admin edits show up immediately
  <FilesMatch "\.(html|js|json|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/xml
</IfModule>
