<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/main_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="#70000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/relTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/titleImage"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@mipmap/title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/demo_quotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_desc"
            android:layout_below="@+id/titleImage"
            android:fontFamily="@font/regular"
            android:textAlignment="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/relTop">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/native_frame"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_margin="10dp"/>
            <RelativeLayout
                android:id="@+id/bottom_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="20dp"
                android:layout_below="@+id/native_frame">
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/relll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <ImageView
                        android:orientation="horizontal"
                        android:id="@+id/linstart"
                        android:layout_width="wrap_content"
                        android:layout_height="80dp"
                        android:src="@mipmap/btn_start"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lin_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2"
                    android:layout_below="@+id/relll"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/linrate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:src="@mipmap/btn_rate"/>
                        </LinearLayout>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/linshare"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:src="@mipmap/btn_share"/>
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lin_bottom1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2"
                    android:layout_below="@+id/lin_bottom"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/linprivacy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:src="@mipmap/btn_privacy"/>
                        </LinearLayout>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/linmoreapps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:src="@mipmap/btn_more_app"/>
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
